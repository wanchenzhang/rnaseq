/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }
    withName: TRIMGALORE {
        cpus = 4
        memory = '8.GB'
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/trimgalore" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
        withName: FASTP {
        cpus = 4
        memory = '4.GB'
        ext.args = {
            [
                params.fastp_trim_poly_x ? '--trim_poly_x' : '',
                params.fastp_poly_g == 'on' ? '--trim_poly_g' : '',
                params.fastp_poly_g == 'off' ? '--disable_trim_poly_g' : '',
                params.fastp_correction ? '--correction' : ''
            ].findAll { it }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode
        ]
    }
    withName: FASTQC_AFTER {
        ext.args = '--quiet'
        ext.prefix = { "${meta.id}_trimmed" }
        publishDir = [
            path: { "${params.outdir}/fastqc_after" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: STAR_GENOMEGENERATE {
        cpus = 8
        memory = '20.GB'
        maxForks = 1

        ext.args = '--genomeSAindexNbases 10 --sjdbOverhang 149'

        publishDir = [
            path: { "${params.outdir}/reference/star" },
            mode: params.publish_dir_mode
        ]
    }

    withName: GFFREAD {
        cpus = 1
        memory = '2.GB'

        ext.args = '-w'
        ext.prefix = 'reference_transcripts'

        publishDir = [
            path: { "${params.outdir}/reference/transcripts" },
            mode: params.publish_dir_mode
        ]
    }
        withName: STAR_ALIGN {
        cpus = 8
        memory = '20.GB'
        maxForks = 1

        ext.args = '--readFilesCommand zcat --quantMode TranscriptomeSAM --outSAMtype BAM SortedByCoordinate --limitBAMsortRAM 1000000000'

        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode
        ]
    }

    withName: SALMON_QUANT {
        cpus = 4
        memory = '4.GB'
        maxForks = 1

        ext.args = '--libType A'

        publishDir = [
            path: { "${params.outdir}/salmon" },
            mode: params.publish_dir_mode
        ]
    }

    withName: PICARD_MARKDUPLICATES {
        cpus = 1
        memory = '6.GB'
        maxForks = 1

        ext.args = '--REMOVE_DUPLICATES false --CREATE_INDEX true'
        ext.prefix = { "${meta.id}_marked" }

        publishDir = [
            path: { "${params.outdir}/markduplicates" },
            mode: params.publish_dir_mode
        ]
    }
        withName: CUSTOM_TX2GENE {
        cpus = 1
        memory = '2.GB'

        ext.prefix = 'reference'

        publishDir = [
            path: { "${params.outdir}/tximport" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
        withName: TXIMETA_TXIMPORT {
        cpus = 1
        memory = '4.GB'

        ext.prefix = 'salmon_merged'

        publishDir = [
            path: { "${params.outdir}/tximport" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}