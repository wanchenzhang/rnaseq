/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Compatibility alias for the course integration test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A separate full-size test dataset has not been configured.
    Reuse the working test profile instead of unrelated template data.

    Use as follows:
        nextflow run . -profile test_full,docker --outdir results_test

----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Test profile (test_full alias)'
    config_profile_description = 'Same small integration dataset as test; not a full-size benchmark'
}
